<!DOCTYPE html>
<html lang="en-GB">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Newsletter – {{month}} {{year}} | Chorlton Bikes</title>
    <link rel="canonical" href="{{canonicalUrl}}">
    <link rel="icon" type="image/png" href="../assets/images/logo.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lilita+One&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="../redesign.css?v=20261016a">
</head>
<body class="issue" id="top">
    <header class="nav">
        <div class="nav-inner">
            <a href="/" aria-label="Chorlton Bikes homepage">
                <img class="logo" src="../assets/images/logo-white.png" alt="Chorlton Bikes">
            </a>
            <button class="nav-toggle" type="button" aria-expanded="false" aria-label="Menu">
                <span></span>
            </button>
            <ul class="nav-links">
                <li><a href="/#work">What we do</a></li>
                <li><a href="/#book">Book a delivery</a></li>
                <li><a href="/#road">On the road</a></li>
                <li><a href="/#films">Films</a></li>
                <li><a href="/#panel-friend">Donate</a></li>
                <li><a class="nav-join" href="/#panel-member">Join — £1</a></li>
            </ul>
        </div>
    </header>

    <main>
    <div class="newsletter-hello-block">
        <div class="inner">
            <p class="intro">{{intro.greeting}}</p>
            {{#each intro.paragraphs}}
            <p>{{this}}</p>
            {{/each}}
        </div>
    </div>

    <div class="newsletter-january-block">
        <div class="inner">
            <div class="title-col">
                <p class="month">{{month}}</p>
                <p class="year">{{year}}</p>
            </div>
            <div class="text-col">
                <p>{{monthIntro}}</p>
            </div>
        </div>
    </div>

    {{#each sections}}
    <div class="newsletter-article-block {{blockClass}}">
        <div class="inner">
            {{#if imagesHtml}}
            {{{imagesHtml}}}
            {{/if}}
            <h2>{{title}}</h2>
            <ul>
                {{#each bullets}}
                <li>{{this}}</li>
                {{/each}}
            </ul>
            {{{ctaHtml}}}
        </div>
    </div>
    {{/each}}

    <div class="newsletter-thankyou-block">
        <div class="inner">
            <h2>Thank you</h2>
            {{#each thankYou.paragraphs}}
            <p>{{this}}</p>
            {{/each}}
        </div>
    </div>
    </main>

    <footer class="footer">
        <div class="wrap footer-grid">
            <div>
                <h2>Visit</h2>
                <p>Boiler House, 9 Wilcock Street<br>Moss Side, Manchester, M16 7DA</p>
                <p>Monday to Saturday, 9am–5pm</p>
                <p><a href="https://maps.app.goo.gl/LZXcpTXvTtkWwr8o9" target="_blank" rel="noopener noreferrer">Map</a></p>
            </div>
            <div>
                <h2>Talk to us</h2>
                <p><a href="mailto:hello@chorltonbikes.coop">hello@chorltonbikes.coop</a></p>
                <p><a href="tel:+447561737986">07561 737986</a></p>
                <p><a href="https://wa.me/447561737986" target="_blank" rel="noopener noreferrer">WhatsApp</a></p>
            </div>
            <div>
                <h2>Follow</h2>
                <p><a href="https://www.instagram.com/chorltonbikes" target="_blank" rel="noopener noreferrer">Instagram</a></p>
                <p><a href="https://www.facebook.com/chorltonbikedeliveries/" target="_blank" rel="noopener noreferrer">Facebook</a></p>
            </div>
            <div>
                <img class="footer-logo" src="../assets/images/real-living-wage-logo.webp" alt="Real Living Wage employer">
            </div>
        </div>
        <div class="wrap footer-base">
            <p>© {{footerYear}} Chorlton Bikes Community Benefit Society. <a href="../privacy-policy.html">Privacy</a></p>
        </div>
    </footer>
    <script src="../redesign.js?v=20261016a"></script>
</body>
</html>
